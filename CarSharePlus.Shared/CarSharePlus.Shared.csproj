<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target: soporta tanto MVC en net7 como Mobile en net8 -->
    <TargetFrameworks>net7.0;net8.0;net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
      $(TargetFrameworks);net7.0-windows10.0.19041.0;net8.0-windows10.0.19041.0
    </TargetFrameworks>

    <OutputType>Library</OutputType>
    <RootNamespace>CarSharePlus.Shared</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core en rama 7 para MVC -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="7.0.20" Condition="'$(TargetFramework)' == 'net7.0'" />
    <!-- EF Core en rama 8 para Mobile -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" Condition="'$(TargetFramework)' == 'net8.0'" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Incluye explícitamente la carpeta ViewModels -->
  <ItemGroup>
    <Compile Include="ViewModels\**\*.cs" />
  </ItemGroup>

  <!-- Referencias ajustadas -->
  <ItemGroup>
    <Reference Include="System.Runtime, Version=7.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" Condition="'$(TargetFramework)' == 'net7.0'" />
    <Reference Include="System.Runtime, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
</Project>
