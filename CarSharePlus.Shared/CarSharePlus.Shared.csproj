<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Usa netstandard2.0 si quieres máxima compatibilidad -->
    <!-- También puedes usar net8.0 si todos tus proyectos están en .NET 8 -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Opcional: habilita nullable para mejores validaciones -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
  </ItemGroup>

</Project>
