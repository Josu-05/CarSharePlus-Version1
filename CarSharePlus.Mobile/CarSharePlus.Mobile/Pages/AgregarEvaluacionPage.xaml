<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarSharePlus.Mobile.AgregarEvaluacionPage"
             Title="AgregarEvaluacionPage">
    <VerticalStackLayout Padding="20">
        <Label Text="Nueva Evaluación" FontSize="24" FontAttributes="Bold" />
        <Label Text="Vehículo ID" />
        <Entry Text="{Binding VehiculoId}" Keyboard="Numeric" />
        <Label Text="Calificación (1-5)" />
        <Entry Text="{Binding Calificacion}" Keyboard="Numeric" />
        <Label Text="Comentario" />
        <Editor Text="{Binding Comentario}" HeightRequest="100" />
        <Button Text="Guardar Evaluación" Command="{Binding GuardarCommand}" Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>