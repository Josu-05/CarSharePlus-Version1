<Shell
    x:Class="CarSharePlus.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CarSharePlus.Mobile.Pages">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Estilo visual del Shell -->
            <Style TargetType="Shell">
                <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource SecondaryColor}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource UnselectedColor}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryColor}" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent Title="Mapa" ContentTemplate="{DataTemplate pages:MapasPage}" Icon="map.png" />
        <ShellContent Title="Reservas" ContentTemplate="{DataTemplate pages:ReservasPage}" Icon="reservas.png" />
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate pages:DashboardPage}" Icon="dashboard.png" />
    </TabBar>
</Shell>
