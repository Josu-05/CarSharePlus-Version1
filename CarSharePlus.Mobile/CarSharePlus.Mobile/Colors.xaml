<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <SolidColorBrush x:Key="PrimaryColor">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="#512BD4" Dark="#9A6AFF" />
        </SolidColorBrush.Color>
    </SolidColorBrush>

    <SolidColorBrush x:Key="SecondaryColor">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="#FFFFFF" Dark="#1E1E1E" />
        </SolidColorBrush.Color>
    </SolidColorBrush>

    <SolidColorBrush x:Key="UnselectedColor">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="#B0B0B0" Dark="#808080" />
        </SolidColorBrush.Color>
    </SolidColorBrush>

</ResourceDictionary>