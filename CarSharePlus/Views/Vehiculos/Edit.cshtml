@model CarSharePlus.Shared.Models.Vehiculo
@using CarSharePlus.Shared.Models

@{
    ViewData["Title"] = "Editar Vehículo";
}

<h2>Editar Vehículo</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="alert alert-info">
    <i class="fas fa-info-circle"></i>
    <strong>Información:</strong> Modifique los datos del vehículo y actualice la asignación si es necesario.
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <!-- Datos básicos -->
            <div class="form-group">
                <label asp-for="Marca" class="control-label"></label>
                <input asp-for="Marca" class="form-control" placeholder="Ej. Toyota" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Modelo" class="control-label"></label>
                <input asp-for="Modelo" class="form-control" placeholder="Ej. Corolla" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Anio" class="control-label"></label>
                <input asp-for="Anio" class="form-control" type="number" min="1990" max="2050" placeholder="Ej. 2024" />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Placa" class="control-label"></label>
                <input asp-for="Placa" class="form-control" placeholder="Ej. ABC-1234" />
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>

            <!-- Características técnicas -->
            <div class="form-group">
                <label asp-for="Transmision" class="control-label"></label>
                <select asp-for="Transmision" class="form-control"
                        asp-items="Html.GetEnumSelectList<TipoTransmision>()"></select>
                <span asp-validation-for="Transmision" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Energia" class="control-label"></label>
                <select asp-for="Energia" class="form-control"
                        asp-items="Html.GetEnumSelectList<TipoEnergia>()"></select>
                <span asp-validation-for="Energia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AutonomiaKm" class="control-label"></label>
                <input asp-for="AutonomiaKm" class="form-control" type="number" min="0" placeholder="Ej. 450" />
                <span asp-validation-for="AutonomiaKm" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConsumoPorKm" class="control-label"></label>
                <input asp-for="ConsumoPorKm" class="form-control" type="number" step="0.01" min="0" placeholder="Ej. 0.12" />
                <span asp-validation-for="ConsumoPorKm" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="Disponible" class="form-check-input" />
                <label asp-for="Disponible" class="form-check-label"></label>
                <span asp-validation-for="Disponible" class="text-danger"></span>
            </div>

            <!-- Asignación -->
            <div class="form-group">
                <label asp-for="UsuarioId" class="control-label">Usuario asignado</label>
                <select asp-for="UsuarioId" class="form-control" asp-items="ViewBag.UsuarioId">
                    <option value="">-- Seleccione un usuario --</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>

            <!-- Botones -->
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Actualizar
            </button>
            <a class="btn btn-secondary" href="@Url.Action("Index")">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
            <a class="btn btn-info" href="@Url.Action("Details", new { id = Model.Id })">
                <i class="fas fa-info-circle"></i> Detalles
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
