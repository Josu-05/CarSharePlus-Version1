@model CarSharePlus.Shared.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<h2>@ViewData["Title"]</h2>

<hr />

<!-- Resumen de validaciones -->
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ReservaId" />

    <div class="form-group mb-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Metodo" class="form-label"></label>
        <select asp-for="Metodo" class="form-select">
            <option value="Tarjeta">Tarjeta</option>
            <option value="Efectivo">Efectivo</option>
            <option value="Transferencia">Transferencia</option>
        </select>
        <span asp-validation-for="Metodo" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaPago" class="form-label"></label>
        <input asp-for="FechaPago" class="form-control" type="datetime-local" />
        <span asp-validation-for="FechaPago" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Confirmado" class="form-check-input" />
        <label asp-for="Confirmado" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
