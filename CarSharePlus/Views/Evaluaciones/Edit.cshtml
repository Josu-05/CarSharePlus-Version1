@model CarSharePlus.Shared.Models.Evaluacion

<h2>Editar Evaluación</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label>Usuario</label>
        <select asp-for="UsuarioId" asp-items="ViewBag.UsuarioId" class="form-control"></select>
    </div>
    <div class="form-group">
        <label>Vehículo</label>
        <select asp-for="VehiculoId" asp-items="ViewBag.VehiculoId" class="form-control"></select>
    </div>
    <div class="form-group">
        <label>Calificación (1-5)</label>
        <input asp-for="Calificacion" class="form-control" type="number" min="1" max="5" />
    </div>
    <div class="form-group">
        <label>Comentario</label>
        <textarea asp-for="Comentario" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
