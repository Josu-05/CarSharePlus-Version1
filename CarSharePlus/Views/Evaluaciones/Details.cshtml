@model CarSharePlus.Shared.Models.Evaluacion

<h2>Detalles de Evaluación</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Usuario</dt>
        <dd class="col-sm-10">@Model.Usuario?.Nombre</dd>

        <dt class="col-sm-2">Vehículo</dt>
        <dd class="col-sm-10">@Model.Vehiculo?.Placa</dd>

        <dt class="col-sm-2">Calificación</dt>
        <dd class="col-sm-10">@Model.Calificacion</dd>

        <dt class="col-sm-2">Comentario</dt>
        <dd class="col-sm-10">@Model.Comentario</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Fecha.ToShortDateString()</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
