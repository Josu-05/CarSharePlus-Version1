@model CarSharePlus.Shared.Models.Evaluacion

<h2>Nueva Evaluación</h2>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label>Usuario</label>
        <select asp-for="UsuarioId" asp-items="ViewBag.UsuarioId" class="form-control"></select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Vehículo</label>
        <select asp-for="VehiculoId" asp-items="ViewBag.VehiculoId" class="form-control"></select>
        <span asp-validation-for="VehiculoId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Calificación (1-5)</label>
        <input asp-for="Calificacion" class="form-control" type="number" min="1" max="5" />
        <span asp-validation-for="Calificacion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Comentario</label>
        <textarea asp-for="Comentario" class="form-control"></textarea>
        <span asp-validation-for="Comentario" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
